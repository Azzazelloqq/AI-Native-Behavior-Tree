{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aibt.dev/schemas/0.1/layout.schema.json",
  "title": "AIBT shared editor layout",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "treeId"],
  "properties": {
    "format": { "const": "aibt.layout" },
    "formatVersion": { "type": "integer", "const": 1 },
    "treeId": { "$ref": "#/$defs/id" },
    "direction": { "enum": ["topToBottom", "leftToRight"] },
    "nodes": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/nodeLayout" }
    },
    "groups": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/group" }
    },
    "notes": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/note" }
    },
    "reroutes": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}\\|[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "additionalProperties": { "$ref": "#/$defs/reroute" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "nodeLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position"],
      "properties": {
        "position": { "$ref": "#/$defs/point" },
        "pinned": { "type": "boolean", "default": false }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "memberNodeIds"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "locked": { "type": "boolean", "default": false },
        "memberNodeIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "position", "size"],
      "properties": {
        "text": { "type": "string" },
        "position": { "$ref": "#/$defs/point" },
        "size": { "$ref": "#/$defs/point" },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
      }
    },
    "reroute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waypoints"],
      "properties": {
        "waypoints": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/point" }
        }
      }
    }
  }
}
