{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aibt.dev/schemas/0.1/behavior-case.schema.json",
  "title": "AIBT behavior test case",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "name", "tree", "treeInstanceId", "rootSeed", "steps"],
  "properties": {
    "format": { "const": "aibt.case" },
    "formatVersion": { "type": "integer", "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "tree": { "type": "string", "minLength": 1 },
    "treeInstanceId": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
    "rootSeed": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
    "initialBlackboard": { "$ref": "#/$defs/valueMap" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/update" },
          { "$ref": "#/$defs/resume" },
          { "$ref": "#/$defs/restart" },
          { "$ref": "#/$defs/abort" }
        ]
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "$defs": {
    "typedValue": {
      "oneOf": [
        { "$ref": "#/$defs/boolValue" },
        { "$ref": "#/$defs/int32Value" },
        { "$ref": "#/$defs/int64Value" },
        { "$ref": "#/$defs/float32Value" },
        { "$ref": "#/$defs/float64Value" },
        { "$ref": "#/$defs/float2Value" },
        { "$ref": "#/$defs/float3Value" },
        { "$ref": "#/$defs/quaternionValue" },
        { "$ref": "#/$defs/enum32Value" },
        { "$ref": "#/$defs/string32Value" },
        { "$ref": "#/$defs/string64Value" },
        { "$ref": "#/$defs/string128Value" },
        { "$ref": "#/$defs/string512Value" },
        { "$ref": "#/$defs/agentIdValue" },
        { "$ref": "#/$defs/entityIdValue" },
        { "$ref": "#/$defs/operationIdValue" },
        { "$ref": "#/$defs/assetIdValue" },
        { "$ref": "#/$defs/registeredValue" }
      ]
    },
    "scalarValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": { "type": {}, "value": {} }
    },
    "boolValue": {
      "allOf": [
        { "$ref": "#/$defs/scalarValue" },
        { "properties": { "type": { "const": "Bool" }, "value": { "type": "boolean" } } }
      ]
    },
    "int32Value": {
      "allOf": [
        { "$ref": "#/$defs/scalarValue" },
        { "properties": { "type": { "const": "Int32" }, "value": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 } } }
      ]
    },
    "int64Value": {
      "allOf": [
        { "$ref": "#/$defs/scalarValue" },
        { "properties": { "type": { "const": "Int64" }, "value": { "type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807 } } }
      ]
    },
    "float32Value": {
      "allOf": [
        { "$ref": "#/$defs/scalarValue" },
        { "properties": { "type": { "const": "Float32" }, "value": { "type": "number" } } }
      ]
    },
    "float64Value": {
      "allOf": [
        { "$ref": "#/$defs/scalarValue" },
        { "properties": { "type": { "const": "Float64" }, "value": { "type": "number" } } }
      ]
    },
    "float2Value": { "$ref": "#/$defs/vector2" },
    "float3Value": { "$ref": "#/$defs/vector3" },
    "quaternionValue": { "$ref": "#/$defs/vector4" },
    "vector2": {
      "type": "object", "additionalProperties": false, "required": ["type", "value"],
      "properties": {
        "type": { "const": "Float2" },
        "value": {
          "type": "object", "additionalProperties": false, "required": ["x", "y"],
          "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
        }
      }
    },
    "vector3": {
      "type": "object", "additionalProperties": false, "required": ["type", "value"],
      "properties": {
        "type": { "const": "Float3" },
        "value": {
          "type": "object", "additionalProperties": false, "required": ["x", "y", "z"],
          "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } }
        }
      }
    },
    "vector4": {
      "type": "object", "additionalProperties": false, "required": ["type", "value"],
      "properties": {
        "type": { "const": "Quaternion" },
        "value": {
          "type": "object", "additionalProperties": false, "required": ["x", "y", "z", "w"],
          "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" }, "w": { "type": "number" } }
        }
      }
    },
    "enum32Value": {
      "type": "object", "additionalProperties": false, "required": ["type", "contract", "value"],
      "properties": {
        "type": { "const": "Enum32" },
        "contract": { "type": "string", "minLength": 1 },
        "value": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 }
      }
    },
    "string32Value": { "$ref": "#/$defs/stringValue32" },
    "string64Value": { "$ref": "#/$defs/stringValue64" },
    "string128Value": { "$ref": "#/$defs/stringValue128" },
    "string512Value": { "$ref": "#/$defs/stringValue512" },
    "stringValue32": { "type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": { "type": { "const": "FixedString32" }, "value": { "type": "string" } } },
    "stringValue64": { "type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": { "type": { "const": "FixedString64" }, "value": { "type": "string" } } },
    "stringValue128": { "type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": { "type": { "const": "FixedString128" }, "value": { "type": "string" } } },
    "stringValue512": { "type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": { "type": { "const": "FixedString512" }, "value": { "type": "string" } } },
    "agentIdValue": { "type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": { "type": { "const": "AgentId" }, "value": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 } } },
    "entityIdValue": { "type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": { "type": { "const": "EntityId" }, "value": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 } } },
    "operationId": {
      "type": "object", "additionalProperties": false,
      "required": ["treeInstanceId", "nodeIndex", "activationGeneration", "sequence"],
      "properties": {
        "treeInstanceId": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        "nodeIndex": { "type": "integer", "minimum": 0, "maximum": 4294967294 },
        "activationGeneration": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "sequence": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 }
      }
    },
    "operationIdValue": {
      "type": "object", "additionalProperties": false, "required": ["type", "value"],
      "properties": { "type": { "const": "OperationId" }, "value": { "$ref": "#/$defs/operationId" } }
    },
    "assetIdValue": {
      "type": "object", "additionalProperties": false, "required": ["type", "value"],
      "properties": {
        "type": { "const": "AssetId" },
        "value": {
          "type": "object", "additionalProperties": false, "required": ["guid"],
          "properties": {
            "guid": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
            "localFileId": { "type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807 }
          }
        }
      }
    },
    "registeredValue": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "typeId", "typeVersion", "encoding", "value"],
      "properties": {
        "type": { "const": "Registered" },
        "typeId": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        "typeVersion": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "encoding": { "const": "base64" },
        "value": { "type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" }
      }
    },
    "valueMap": { "type": "object", "additionalProperties": { "$ref": "#/$defs/typedValue" } },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceId", "sourceSequence", "eventTypeId", "eventTypeVersion", "payload"],
      "properties": {
        "sourceId": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        "sourceSequence": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
        "eventTypeId": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        "eventTypeVersion": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "payload": { "$ref": "#/$defs/typedValue" }
      }
    },
    "completion": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceId", "sourceSequence", "operationId", "outcome", "snapshotRevision"],
      "properties": {
        "sourceId": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        "sourceSequence": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
        "operationId": { "$ref": "#/$defs/operationId" },
        "outcome": { "enum": ["succeeded", "failed", "cancelled"] },
        "snapshotRevision": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        "payload": { "$ref": "#/$defs/registeredValue" }
      }
    },
    "update": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "updateId", "snapshotRevision", "timeMicroseconds"],
      "properties": {
        "operation": { "const": "update" },
        "updateId": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        "snapshotRevision": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        "timeMicroseconds": { "type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807 },
        "stepBudget": { "type": ["integer", "null"], "minimum": 0, "maximum": 18446744073709551615 },
        "events": { "type": "array", "items": { "$ref": "#/$defs/event" } },
        "completions": { "type": "array", "items": { "$ref": "#/$defs/completion" } },
        "expect": { "$ref": "#/$defs/expect" }
      }
    },
    "resume": {
      "type": "object", "additionalProperties": false, "required": ["operation"],
      "properties": {
        "operation": { "const": "resume" },
        "stepBudget": { "type": ["integer", "null"], "minimum": 0, "maximum": 18446744073709551615 },
        "expect": { "$ref": "#/$defs/expect" }
      }
    },
    "restart": {
      "type": "object", "additionalProperties": false, "required": ["operation"],
      "properties": { "operation": { "const": "restart" }, "expect": { "$ref": "#/$defs/expect" } }
    },
    "abort": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "updateId", "snapshotRevision", "timeMicroseconds"],
      "properties": {
        "operation": { "const": "abort" },
        "updateId": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        "snapshotRevision": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        "timeMicroseconds": { "type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807 },
        "stepBudget": { "type": ["integer", "null"], "minimum": 0, "maximum": 18446744073709551615 },
        "completions": { "type": "array", "items": { "$ref": "#/$defs/completion" } },
        "expect": { "$ref": "#/$defs/expect" }
      }
    },
    "expect": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "progress": { "enum": ["completed", "waiting", "suspended", "rejected", "faulted"] },
        "rootStatus": { "enum": ["success", "failure"] },
        "executedSteps": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
        "blackboard": { "type": "array", "items": { "$ref": "#/$defs/blackboardExpectation" } },
        "commands": { "$ref": "#/$defs/commandSet" },
        "trace": { "type": "array", "items": { "$ref": "#/$defs/traceExpectation" } },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnosticExpectation" } },
        "invariants": { "type": "array", "items": { "$ref": "#/$defs/invariant" } }
      }
    },
    "blackboardExpectation": {
      "type": "object", "additionalProperties": false, "required": ["key", "value"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "value": { "$ref": "#/$defs/typedValue" },
        "version": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
        "absoluteTolerance": { "type": "number", "minimum": 0 },
        "relativeTolerance": { "type": "number", "minimum": 0 }
      }
    },
    "commandSet": {
      "type": "object", "additionalProperties": false, "required": ["match", "records"],
      "properties": {
        "match": { "enum": ["exact", "ordered-subset"] },
        "records": { "type": "array", "items": { "$ref": "#/$defs/commandExpectation" } }
      }
    },
    "commandExpectation": {
      "type": "object", "additionalProperties": false,
      "required": ["phase", "typeId", "typeVersion", "treeInstanceId", "sequence", "payload"],
      "properties": {
        "phase": { "enum": ["execute", "cancel"] },
        "typeId": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        "typeVersion": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "treeInstanceId": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        "operationId": { "$ref": "#/$defs/operationId" },
        "payload": { "$ref": "#/$defs/registeredValue" }
      }
    },
    "traceExpectation": {
      "type": "object", "additionalProperties": false, "required": ["event"],
      "properties": {
        "event": { "enum": ["update-started", "update-completed", "node-entered", "node-ticked", "node-abort-started", "node-exited", "blackboard-changed", "observer-queued", "observer-evaluated", "command-emitted", "completion-consumed", "completion-discarded", "diagnostic-raised", "budget-yielded", "execution-resumed"] },
        "traceFormatVersion": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "treeSemanticHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "treeInstanceId": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        "updateId": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        "snapshotRevision": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        "nodeIndex": { "type": "integer", "minimum": 0, "maximum": 4294967294 },
        "status": { "enum": ["success", "failure", "running"] },
        "exitReason": { "enum": ["success", "failure", "aborted"] },
        "abortReason": { "enum": ["explicit", "observer-self", "observer-lower-priority", "tree-stopped", "hot-reload", "timeout"] },
        "sourceNodeIndex": { "type": "integer", "minimum": 0, "maximum": 4294967294 },
        "diagnosticCode": { "type": "string", "pattern": "^AIBT[0-9]{4}$" },
        "stableBlackboardKeyId": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        "oldBlackboardVersion": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
        "newBlackboardVersion": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 }
      }
    },
    "diagnosticExpectation": {
      "type": "object", "additionalProperties": false, "required": ["code", "severity"],
      "properties": {
        "code": { "type": "string", "pattern": "^AIBT[0-9]{4}$" },
        "severity": { "enum": ["error", "warning", "info"] },
        "documentId": { "type": "string", "minLength": 1 },
        "jsonPointer": { "type": "string", "pattern": "^(?:|/.*)$" },
        "treeInstanceId": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        "nodeId": { "type": "string", "minLength": 1 }
      }
    },
    "invariant": {
      "type": "object", "additionalProperties": false, "required": ["kind"],
      "properties": {
        "kind": { "enum": ["no-error-diagnostics", "no-duplicate-command-sequences", "no-active-operation-leaks", "terminal-root-has-no-active-nodes"] }
      }
    }
  }
}
