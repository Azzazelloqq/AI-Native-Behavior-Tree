{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aibt.dev/schemas/0.1/tree.schema.json",
  "title": "AIBT semantic tree",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "treeId", "name", "root", "nodes"],
  "properties": {
    "format": { "const": "aibt.tree" },
    "formatVersion": { "type": "integer", "const": 1 },
    "treeId": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "root": { "$ref": "#/$defs/id" },
    "blackboard": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/blackboardEntry" }
    },
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/node" }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "metadata": { "type": "object" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "blackboardEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "scope": {
          "enum": ["local", "tree", "agent", "shared"]
        },
        "description": { "type": "string" },
        "default": true
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "typeVersion"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "typeVersion": { "type": "integer", "minimum": 1 },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "parameters": { "type": "object" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
