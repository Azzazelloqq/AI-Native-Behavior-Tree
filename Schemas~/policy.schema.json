{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aibt.dev/schemas/0.1/policy.schema.json",
  "title": "AIBT project policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "allowManagedNodes",
    "allowMainThreadNodes",
    "requireTreeDescription",
    "requireNodeDescriptions",
    "blackboardNaming",
    "forbiddenNodeTypes",
    "requireDeterministicNodes",
    "allowSideEffects",
    "unreachableNodes",
    "supportsAgentScope",
    "supportsSharedScope",
    "warningsAsErrors",
    "performance"
  ],
  "properties": {
    "format": { "const": "aibt.policy" },
    "formatVersion": { "type": "integer", "const": 1 },
    "maxTreeDepth": { "type": "integer", "minimum": 1 },
    "maxNodesPerTree": { "type": "integer", "minimum": 1 },
    "allowManagedNodes": { "type": "boolean" },
    "allowMainThreadNodes": { "type": "boolean" },
    "requireTreeDescription": { "type": "boolean" },
    "requireNodeDescriptions": { "type": "boolean" },
    "blackboardNaming": { "enum": ["snake_case", "camelCase", "PascalCase", "any"] },
    "requireDeterministicNodes": { "type": "boolean" },
    "allowSideEffects": { "type": "boolean" },
    "unreachableNodes": { "enum": ["error", "warning", "allow"] },
    "supportsAgentScope": { "type": "boolean" },
    "supportsSharedScope": { "type": "boolean" },
    "forbiddenNodeTypes": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "warningsAsErrors": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forbidUnboundedRepeaters", "requireEventDrivenServices"],
      "properties": {
        "maxEstimatedCost": { "type": "number", "minimum": 0 },
        "forbidUnboundedRepeaters": { "type": "boolean" },
        "requireEventDrivenServices": { "type": "boolean" }
      }
    }
  }
}
