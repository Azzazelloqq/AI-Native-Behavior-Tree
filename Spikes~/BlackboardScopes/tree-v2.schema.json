{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aibt.dev/spikes/blackboard-scopes/tree-v2.schema.json",
  "title": "AIBT semantic tree v2 Agent/Shared contract candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "treeId", "name", "root", "nodes"],
  "properties": {
    "format": { "const": "aibt.tree" },
    "formatVersion": { "type": "integer", "const": 2 },
    "treeId": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "root": { "$ref": "#/$defs/id" },
    "blackboardContracts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": { "$ref": "#/$defs/scopeContract" },
        "shared": { "$ref": "#/$defs/scopeContract" }
      },
      "minProperties": 1
    },
    "blackboard": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/blackboardEntry" }
    },
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/node" }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "metadata": { "$ref": "#/$defs/semanticObject" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "scopeContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractId", "contractVersion"],
      "properties": {
        "contractId": { "$ref": "#/$defs/id" },
        "contractVersion": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
      }
    },
    "blackboardEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "typeVersion": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "enumContract": { "$ref": "#/$defs/id" },
        "scope": { "enum": ["tree", "agent", "shared"] },
        "reduction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["min", "max", "sum", "any", "all", "first", "last"] }
          }
        },
        "description": { "type": "string" },
        "default": true
      },
      "allOf": [
        {
          "if": {
            "properties": { "scope": { "enum": ["agent", "shared"] } },
            "required": ["scope"]
          },
          "then": {
            "required": ["typeVersion", "scope", "default"],
            "properties": {
              "typeVersion": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
              "scope": { "enum": ["agent", "shared"] },
              "default": true
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "Enum32" } }, "required": ["type"] },
          "then": {
            "required": ["enumContract"],
            "properties": { "enumContract": { "$ref": "#/$defs/id" } }
          },
          "else": { "properties": { "enumContract": false } }
        },
        {
          "if": { "properties": { "scope": { "const": "shared" } }, "required": ["scope"] },
          "else": { "properties": { "reduction": false } }
        },
        {
          "if": {
            "properties": {
              "reduction": {
                "type": "object",
                "properties": { "kind": { "enum": ["min", "max", "sum"] } },
                "required": ["kind"]
              }
            },
            "required": ["reduction"]
          },
          "then": { "properties": { "type": { "enum": ["Int32", "Int64", "Float32", "Float64"] } } }
        },
        {
          "if": {
            "properties": {
              "reduction": {
                "type": "object",
                "properties": { "kind": { "enum": ["any", "all"] } },
                "required": ["kind"]
              }
            },
            "required": ["reduction"]
          },
          "then": { "properties": { "type": { "const": "Bool" } } }
        }
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "typeVersion"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "typeVersion": { "type": "integer", "minimum": 1 },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "parameters": { "$ref": "#/$defs/semanticObject" },
        "bindings": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/bindingId" },
          "additionalProperties": { "$ref": "#/$defs/bindingId" }
        },
        "observer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "watchedKeys"],
          "properties": {
            "mode": { "enum": ["self", "lower-priority", "both"] },
            "watchedKeys": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/id" },
              "uniqueItems": true
            }
          }
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "semanticValue": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "integer" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/semanticValue" } },
        { "$ref": "#/$defs/semanticObject" }
      ]
    },
    "semanticObject": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/semanticValue" }
    },
    "bindingId": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$"
    }
  }
}
