{
  "format": "aibt.tree",
  "formatVersion": 2,
  "treeId": "samples.native-guard",
  "name": "Native Guard",
  "root": "guard",
  "blackboard": {
    "intruder-close": { "type": "Bool", "typeVersion": 1, "scope": "tree", "default": false },
    "intruder-seen": { "type": "Bool", "typeVersion": 1, "scope": "tree", "default": false },
    "gate-open": { "type": "Bool", "typeVersion": 1, "scope": "tree", "default": false },
    "weapon-ready-at": { "type": "Int64", "typeVersion": 1, "scope": "tree", "default": 0 },
    "sweep-spot": { "type": "Int32", "typeVersion": 1, "scope": "tree", "default": -1 }
  },
  "nodes": {
    "guard": {
      "type": "aibt.core.reactive-selector-retaining",
      "typeVersion": 1,
      "displayName": "Guard: zap, flare, watch or patrol",
      "children": ["zap", "flare", "watch", "patrol"]
    },
    "zap": {
      "type": "aibt.core.reactive-sequence",
      "typeVersion": 1,
      "displayName": "Intruder close: zap",
      "children": ["is-close", "zap-ready", "zap-fire"]
    },
    "is-close": {
      "type": "aibt.native.bool-is-true",
      "typeVersion": 1,
      "displayName": "Intruder close?",
      "bindings": { "key": "intruder-close" }
    },
    "zap-ready": {
      "type": "aibt.native.deadline-passed",
      "typeVersion": 1,
      "displayName": "Weapon ready?",
      "bindings": { "key": "weapon-ready-at" }
    },
    "zap-fire": {
      "type": "aibt.core.memory-sequence",
      "typeVersion": 1,
      "displayName": "Fire zap",
      "children": ["zap-cooldown", "zap-signal", "zap-hold"]
    },
    "zap-cooldown": {
      "type": "aibt.native.set-deadline",
      "typeVersion": 1,
      "displayName": "Weapon cooldown 1.5 s",
      "parameters": { "duration-microseconds": 1500000 },
      "bindings": { "key": "weapon-ready-at" }
    },
    "zap-signal": {
      "type": "aibt.native.signal",
      "typeVersion": 1,
      "displayName": "Signal 1: zap",
      "parameters": { "code": 1 }
    },
    "zap-hold": {
      "type": "aibt.native.idle",
      "typeVersion": 1,
      "displayName": "Hold"
    },
    "flare": {
      "type": "aibt.core.reactive-sequence",
      "typeVersion": 1,
      "displayName": "Intruder seen: flare",
      "children": ["is-seen", "flare-ready", "flare-fire"]
    },
    "is-seen": {
      "type": "aibt.native.bool-is-true",
      "typeVersion": 1,
      "displayName": "Intruder seen?",
      "bindings": { "key": "intruder-seen" }
    },
    "flare-ready": {
      "type": "aibt.native.deadline-passed",
      "typeVersion": 1,
      "displayName": "Weapon ready?",
      "bindings": { "key": "weapon-ready-at" }
    },
    "flare-fire": {
      "type": "aibt.core.memory-sequence",
      "typeVersion": 1,
      "displayName": "Fire flare",
      "children": ["flare-cooldown", "flare-signal", "flare-hold"]
    },
    "flare-cooldown": {
      "type": "aibt.native.set-deadline",
      "typeVersion": 1,
      "displayName": "Weapon cooldown 1.5 s",
      "parameters": { "duration-microseconds": 1500000 },
      "bindings": { "key": "weapon-ready-at" }
    },
    "flare-signal": {
      "type": "aibt.native.signal",
      "typeVersion": 1,
      "displayName": "Signal 2: flare",
      "parameters": { "code": 2 }
    },
    "flare-hold": {
      "type": "aibt.native.idle",
      "typeVersion": 1,
      "displayName": "Hold"
    },
    "watch": {
      "type": "aibt.core.reactive-sequence",
      "typeVersion": 1,
      "displayName": "Intruder seen, weapon cooling: watch",
      "children": ["still-seen", "watch-hold"]
    },
    "still-seen": {
      "type": "aibt.native.bool-is-true",
      "typeVersion": 1,
      "displayName": "Intruder seen?",
      "bindings": { "key": "intruder-seen" }
    },
    "watch-hold": {
      "type": "aibt.native.idle",
      "typeVersion": 1,
      "displayName": "Watch"
    },
    "patrol": {
      "type": "aibt.core.memory-sequence",
      "typeVersion": 1,
      "displayName": "Nobody near: patrol",
      "children": ["open-gate", "wait-gate", "pick-spot", "sweep-spot", "sweep", "maybe-whistle", "rest"]
    },
    "open-gate": {
      "type": "aibt.native.signal",
      "typeVersion": 1,
      "displayName": "Signal 3: open the gate",
      "parameters": { "code": 3 }
    },
    "wait-gate": {
      "type": "aibt.native.wait-until-true",
      "typeVersion": 1,
      "displayName": "Wait until the gate is open (3 s)",
      "parameters": { "timeout-microseconds": 3000000 },
      "bindings": { "key": "gate-open" }
    },
    "pick-spot": {
      "type": "aibt.native.random-int",
      "typeVersion": 1,
      "displayName": "Pick a sweep spot 0-2 (random)",
      "parameters": { "min": 0, "max": 2 },
      "bindings": { "key": "sweep-spot" }
    },
    "sweep-spot": {
      "type": "aibt.core.memory-selector",
      "typeVersion": 1,
      "displayName": "Light the picked spot",
      "children": ["spot-a", "spot-b", "spot-c"]
    },
    "spot-a": {
      "type": "aibt.core.memory-sequence",
      "typeVersion": 1,
      "displayName": "Spot 0: A",
      "children": ["is-spot-a", "light-a"]
    },
    "is-spot-a": {
      "type": "aibt.native.int-equals",
      "typeVersion": 1,
      "displayName": "Spot 0?",
      "parameters": { "value": 0 },
      "bindings": { "key": "sweep-spot" }
    },
    "light-a": {
      "type": "aibt.native.signal",
      "typeVersion": 1,
      "displayName": "Signal 5: light spot A",
      "parameters": { "code": 5 }
    },
    "spot-b": {
      "type": "aibt.core.memory-sequence",
      "typeVersion": 1,
      "displayName": "Spot 1: B",
      "children": ["is-spot-b", "light-b"]
    },
    "is-spot-b": {
      "type": "aibt.native.int-equals",
      "typeVersion": 1,
      "displayName": "Spot 1?",
      "parameters": { "value": 1 },
      "bindings": { "key": "sweep-spot" }
    },
    "light-b": {
      "type": "aibt.native.signal",
      "typeVersion": 1,
      "displayName": "Signal 6: light spot B",
      "parameters": { "code": 6 }
    },
    "spot-c": {
      "type": "aibt.native.signal",
      "typeVersion": 1,
      "displayName": "Otherwise signal 7: light spot C",
      "parameters": { "code": 7 }
    },
    "sweep": {
      "type": "aibt.native.signal",
      "typeVersion": 1,
      "displayName": "Signal 4: sweep and close",
      "parameters": { "code": 4 }
    },
    "maybe-whistle": {
      "type": "aibt.core.memory-selector",
      "typeVersion": 1,
      "displayName": "Whistle 40 % of the time",
      "children": ["whistle", "no-whistle"]
    },
    "whistle": {
      "type": "aibt.core.memory-sequence",
      "typeVersion": 1,
      "displayName": "Whistle",
      "children": ["whistle-chance", "whistle-signal"]
    },
    "whistle-chance": {
      "type": "aibt.native.random-chance",
      "typeVersion": 1,
      "displayName": "Chance 0.4 (random)",
      "parameters": { "chance": 0.4 }
    },
    "whistle-signal": {
      "type": "aibt.native.signal",
      "typeVersion": 1,
      "displayName": "Signal 8: whistle",
      "parameters": { "code": 8 }
    },
    "no-whistle": {
      "type": "aibt.native.succeed",
      "typeVersion": 1,
      "displayName": "No whistle"
    },
    "rest": {
      "type": "aibt.native.wait-random-microseconds",
      "typeVersion": 1,
      "displayName": "Rest 1-3 s (random)",
      "parameters": { "min-microseconds": 1000000, "max-microseconds": 3000000 }
    }
  }
}
