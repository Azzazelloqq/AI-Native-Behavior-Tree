{
  "format": "aibt.tree",
  "formatVersion": 2,
  "treeId": "samples.simple.wander",
  "name": "Wander",
  "description": "Walks to random points, pausing at each.",
  "root": "wander",
  "blackboard": {
    "destination": { "type": "Float3", "typeVersion": 1, "scope": "tree", "default": { "x": 0.0, "y": 0.0, "z": 0.0 } }
  },
  "nodes": {
    "wander": {
      "type": "aibt.core.memory-sequence",
      "typeVersion": 1,
      "displayName": "Wander",
      "children": ["pick-point", "walk", "rest"]
    },
    "pick-point": {
      "type": "samples.simple.pick-random-point",
      "typeVersion": 1,
      "parameters": { "destination": "destination", "radius": 11.0 }
    },
    "walk": {
      "type": "aibt.unity.move-towards",
      "typeVersion": 1,
      "parameters": { "target": "destination", "speed": 5.0, "stop-distance": 0.1, "keep-height": true }
    },
    "rest": {
      "type": "aibt.unity.wait-seconds",
      "typeVersion": 1,
      "parameters": { "seconds": 0.2, "random-extra": 0.4 }
    }
  }
}
