{
  "format": "aibt.tree",
  "formatVersion": 2,
  "treeId": "samples.simple.guard",
  "name": "Guard",
  "description": "Patrols a route, chases a target while it is visible, then returns to the route.",
  "root": "priority",
  "blackboard": {
    "target-visible": { "type": "Bool", "typeVersion": 1, "scope": "tree", "default": false },
    "target-position": { "type": "Float3", "typeVersion": 1, "scope": "tree", "default": { "x": 0.0, "y": 0.0, "z": 0.0 } },
    "waypoint": { "type": "Float3", "typeVersion": 1, "scope": "tree", "default": { "x": 0.0, "y": 0.0, "z": 0.0 } },
    "spotted-again-at": { "type": "Float32", "typeVersion": 1, "scope": "tree", "default": 0.0 }
  },
  "nodes": {
    "priority": {
      "type": "aibt.core.memory-selector",
      "typeVersion": 1,
      "displayName": "Chase or patrol",
      "children": ["chase", "patrol"]
    },
    "chase": {
      "type": "aibt.core.memory-sequence",
      "typeVersion": 1,
      "displayName": "Chase",
      "children": ["sees-target", "alert-on", "announce", "face-target", "run-to-target"]
    },
    "sees-target": {
      "type": "aibt.unity.is-true",
      "typeVersion": 1,
      "displayName": "Sees target?",
      "parameters": { "key": "target-visible", "interrupt": "both" }
    },
    "alert-on": {
      "type": "aibt.unity.set-active",
      "typeVersion": 1,
      "displayName": "Show alert",
      "parameters": { "reference": "alert", "active": true }
    },
    "announce": {
      "type": "aibt.core.memory-selector",
      "typeVersion": 1,
      "displayName": "Announce at most every 3 s",
      "children": ["announce-now", "already-announced"]
    },
    "announce-now": {
      "type": "aibt.core.memory-sequence",
      "typeVersion": 1,
      "displayName": "Announce",
      "children": ["announce-ready", "spotted", "announce-cooldown"]
    },
    "announce-ready": {
      "type": "aibt.unity.is-cooldown-ready",
      "typeVersion": 1,
      "displayName": "Cooldown over?",
      "parameters": { "key": "spotted-again-at" }
    },
    "spotted": {
      "type": "aibt.unity.raise-event",
      "typeVersion": 1,
      "displayName": "Tell gameplay",
      "parameters": { "event-name": "spotted" }
    },
    "announce-cooldown": {
      "type": "aibt.unity.start-cooldown",
      "typeVersion": 1,
      "displayName": "Start 3 s cooldown",
      "parameters": { "key": "spotted-again-at", "seconds": 3.0 }
    },
    "already-announced": {
      "type": "aibt.unity.succeed",
      "typeVersion": 1,
      "displayName": "Skip"
    },
    "face-target": {
      "type": "aibt.unity.look-at",
      "typeVersion": 1,
      "displayName": "Face target",
      "parameters": { "target": "target-position", "degrees-per-second": 720.0 }
    },
    "run-to-target": {
      "type": "aibt.unity.move-towards",
      "typeVersion": 1,
      "displayName": "Run to target",
      "parameters": { "target": "target-position", "speed": 3.0, "stop-distance": 1.2, "keep-height": true }
    },
    "patrol": {
      "type": "aibt.core.memory-sequence",
      "typeVersion": 1,
      "displayName": "Patrol",
      "children": ["alert-off", "next-waypoint", "walk-to-waypoint", "look-around"]
    },
    "alert-off": {
      "type": "aibt.unity.set-active",
      "typeVersion": 1,
      "displayName": "Hide alert",
      "parameters": { "reference": "alert", "active": false }
    },
    "next-waypoint": {
      "type": "samples.simple.next-waypoint",
      "typeVersion": 1,
      "parameters": { "destination": "waypoint" }
    },
    "walk-to-waypoint": {
      "type": "aibt.unity.move-towards",
      "typeVersion": 1,
      "displayName": "Walk to waypoint",
      "parameters": { "target": "waypoint", "speed": 2.0, "stop-distance": 0.1, "keep-height": true }
    },
    "look-around": {
      "type": "aibt.unity.turn-by",
      "typeVersion": 1,
      "displayName": "Look around",
      "parameters": { "degrees": 360.0, "degrees-per-second": 450.0 }
    }
  }
}
